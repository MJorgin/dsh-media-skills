+/**
+ * Rewrite one pre-step message batch: every user message containing image
+ * blocks gets them transcribed through the vision chain (the image block is
+ * kept for the thumbnail, the transcription is appended beside it) or, when
+ * every route fails, the image block is replaced by an inline failure notice
+ * — a text-only model can never receive a raw image block.
+ * @returns the rewritten batch, or null when nothing changed.
+ */
+async function describeImagesInMessages(
+  ctx: Context,
+  cache: Map<string, VisionRoute[]>,
+  messages: readonly UserMessage[],
+  signal: AbortSignal,
+): Promise<UserMessage[] | null> {
+  let changed = false
+  const routes = await findVisionRoutes(ctx, cache)
+  const rewritten = await Promise.all(messages.map(async (message) => {
+    if (!message.content.some(block => block.type === 'image')) return message
+    changed = true
+    const userText = message.content
+      .filter((block): block is TextBlock => block.type === 'text')
+      .map(block => block.text)
+      .join('\n')
+    const imageBlocks = message.content.filter((block): block is ImageBlock => block.type === 'image')
+    const descriptions = await Promise.all(
+      imageBlocks.map(block => describeImage(ctx, routes, block, userText, signal)),
+    )
+    const blocks: ContentBlock[] = []
+    let imageIndex = 0
+    for (const block of message.content) {
+      if (block.type !== 'image') {
+        blocks.push(block)
+        continue
+      }
+      const description = descriptions[imageIndex++]
