+/**
+ * Discover vision-capable model routes in registration order (the failover
+ * chain). Cached until the provider topology changes.
+ * @param ctx - the application context.
+ * @param cache - the per-proxy route cache (cleared on llm/adapters-updated).
+ * @returns provider/model pairs whose model accepts image input.
+ */
+async function findVisionRoutes(ctx: Context, cache: Map<string, VisionRoute[]>): Promise<VisionRoute[]> {
+  const cached = cache.get('routes')
+  if (cached !== undefined) return cached
+  const routes: VisionRoute[] = []
+  for (const provider of ctx.llm.listProviders()) {
+    try {
+      const models = await ctx.llm.listModels(provider.id)
+      const vision = models.find(model => model.inputModalities?.includes('image'))
+      if (vision !== undefined) routes.push({ provider: provider.id, model: vision.id })
+    } catch (error) {
+      ctx.logger.warn(
+        `vision route discovery skipped for "${provider.id}": ${error instanceof Error ? error.message : String(error)}`,
+      )
+    }
+  }
+  cache.set('routes', routes)
+  return routes
+}
+
+/**
+ * Transcribe one image block through the vision failover chain.
+ * @param ctx - the application context.
+ * @param routes - the vision routes in failover order.
+ * @param imageBlock - the durable image block to describe.
+ * @param userText - the user message text riding beside the image.
+ * @param signal - the turn's cancellation signal (combined with a per-route timeout).
+ * @returns the description text, or null when every route failed.
+ */
+async function describeImage(
+  ctx: Context,
+  routes: readonly VisionRoute[],
+  imageBlock: ImageBlock,
+  userText: string,
+  signal: AbortSignal,
+): Promise<string | null> {
+  for (const route of routes) {
+    const controller = new AbortController()
+    const timer = setTimeout(() => controller.abort(), VISION_DESCRIPTION_TIMEOUT_MS)
+    const onAbort = (): void => controller.abort()
+    if (!signal.aborted) signal.addEventListener('abort', onAbort, { once: true })
+    try {
+      const assembler = new BlockAssembler()
+      const stream = ctx.llm.stream({
+        provider: route.provider,
+        model: route.model,
+        maxTokens: VISION_DESCRIPTION_MAX_TOKENS,
+        signal: controller.signal,
+        messages: [createUserMessage({
+          content: [
+            imageBlock,
+            { type: 'text', text: userText.length === 0
+              ? VISION_DESCRIPTION_PROMPT
+              : `${VISION_DESCRIPTION_PROMPT}\n\n用户消息：${userText}` },
+          ],
+          source: { kind: 'user' },
+        })],
+      })
+      for await (const chunk of stream) assembler.push(chunk)
+      const text = assembler.blocks()
+        .filter((block): block is TextBlock => block.type === 'text')
+        .map(block => block.text.trim())
+        .filter(text => text.length > 0)
+        .join('\n')
+      if (assembler.finish.kind !== 'error' && assembler.finish.kind !== 'aborted' && text.length > 0) {
+        return text
+      }
+    } catch {
+      // Fall through to the next route.
+    } finally {
+      clearTimeout(timer)
+      signal.removeEventListener('abort', onAbort)
+    }
+  }
+  return null
