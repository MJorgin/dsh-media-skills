+  // ---- Vision transcription hook (dsh-media-skills HARNESS_PATCH v3) ----
+  // Registered on the shared ctx: every agent with image-bearing pre-step
+  // messages and a text-only current model gets its image blocks transcribed
+  // through the first vision-capable route before the messages enter history
+  // and the request. Steps without image blocks stay on the plain path (the
+  // check is a cheap content scan).
+  const visionRouteCache = new Map<string, VisionRoute[]>()
+  ctx.on('llm/adapters-updated', () => {
+    visionRouteCache.clear()
+  })
+  ctx.on('agent/pre-step', async ({ agent, messages, signal }, next): Promise<PreStepDecision> => {
+    if (!messages.some(message => message.content.some(block => block.type === 'image'))) return next()
+    const decision = await next()
+    if (decision.kind !== 'enter') return decision
+    // A vision-capable current model sees the images natively — nothing to transcribe.
+    const current = selectionFor(agent).current
+    const modelInfo = await ctx.llm.resolveModelInfo(current.provider, current.model, signal)
