+const VISION_DESCRIPTION_MARK = '[图片，已由视觉模型读取]'
+/** Inline notice replacing an image block every route failed to transcribe. */
+const VISION_DESCRIPTION_FAILED = '[图片读取失败：视觉模型不可用，请重试或把图片存成文件后读取]'
+
+/** One vision-capable route: provider route plus its first image-accepting model. */
+interface VisionRoute {
+  readonly provider: string
+  readonly model: string
