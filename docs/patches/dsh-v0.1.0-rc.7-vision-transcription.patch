+/**
+ * Project image blocks out of one request when the target model does not
+ * accept images. Every other block survives, the durable history stays
+ * untouched, and unknown capability passes through unprojected — only a
+ * model that explicitly omits `image` from its input modalities is stripped.
+ * @param messages - the request messages to project.
+ * @param inputModalities - the target model's accepted request modalities, when known.
+ * @returns the projected messages (the same array when nothing changed).
+ */
+function projectImageBlocks(
+  messages: readonly Message[],
+  inputModalities: readonly ModelModality[] | undefined,
+): readonly Message[] {
+  if (inputModalities !== undefined && inputModalities.includes('image')) return messages
+  let changed = false
+  const projected = messages.map((message) => {
+    if (!message.content.some(block => block.type === 'image')) return message
+    changed = true
+    return freezeMessage({
+      ...message,
+      content: message.content.filter(block => block.type !== 'image'),
+    })
+  })
+  return changed ? projected : messages
+}
